{
  "name": "athletemind",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "AthleteMind - Bio-Bounty Hunter: webcam pose-controlled rehab game",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build && rm -rf server/dist && cp -r dist server/dist",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test:smoke": "esbuild smoke/smoke.ts --bundle --platform=node --format=cjs --outfile=/tmp/athletemind-smoke.cjs --log-level=error && node /tmp/athletemind-smoke.cjs",
    "test:clash": "esbuild smoke/clash.ts --bundle --platform=node --format=cjs --outfile=/tmp/athletemind-clash.cjs --log-level=error && node /tmp/athletemind-clash.cjs",
    "lint": "tsc --noEmit",
    "postinstall": "node -e \"const fs=require('fs'),p='node_modules/@mediapipe/tasks-vision/vision_bundle.mjs.map',t='node_modules/@mediapipe/tasks-vision/vision_bundle_mjs.js.map';if(fs.existsSync(p)&&!fs.existsSync(t))fs.copyFileSync(p,t);\""
  },
  "overrides": {
    "chokidar": {
      "braces": "3.0.3"
    },
    "braces": "3.0.3",
    "micromatch": "4.0.8",
    "postcss-selector-parser": "^7.1.6"
  },
  "dependencies": {
    "@mediapipe/tasks-vision": "^0.10.18",
    "@react-three/drei": "^9.114.3",
    "@react-three/fiber": "^8.17.10",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "three": "^0.169.0",
    "zustand": "^5.0.0"
  },
  "devDependencies": {
    "@types/react": "^18.3.11",
    "@types/react-dom": "^18.3.1",
    "@types/three": "^0.169.0",
    "@vitejs/plugin-basic-ssl": "^1.2.0",
    "@vitejs/plugin-react": "^4.3.2",
    "autoprefixer": "^10.4.20",
    "esbuild": "^0.21.5",
    "postcss": "^8.4.47",
    "tailwindcss": "^3.4.14",
    "typescript": "^5.6.3",
    "vite": "^5.4.9"
  }
}
